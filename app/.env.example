# Browser Solana Devnet RPC endpoint (replace with Helius/QuickNode Devnet URL on Vercel to avoid public 429s)
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com

# Server-side Solana Devnet RPC endpoint used by /api/x402/resource, /api/faucet, and /api/status
SOLANA_RPC_URL=https://api.devnet.solana.com

# Optional server-only Devnet faucet keypair (JSON 64-byte array "[1,2,...]" OR base58 secret key; NEVER prefix with NEXT_PUBLIC_)
FAUCET_SECRET_KEY=

# Upstash Redis REST credentials for atomic cross-instance SET NX EX receipt replay & faucet cooldowns
# (Automatically falls back to KV_REST_API_URL / KV_REST_API_TOKEN or in-memory Map in local dev)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Set to "true" on Judge Sandbox previews to allow browser-minted MockUSDC vaults; set "false" in production
ALLOW_SANDBOX_MOCK_MINT=true

# Canonical SPL mint strictly enforced when ALLOW_SANDBOX_MOCK_MINT !== "true" (Solana Devnet USDC)
EXPECTED_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
