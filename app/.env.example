# Public Solana Devnet RPC endpoint used by browser Judge Sandbox
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com

# Server-side Solana Devnet RPC endpoint used by /api/x402/resource and /api/faucet
SOLANA_RPC_URL=https://api.devnet.solana.com

# Canonical SPL mint enforced by /api/x402/resource (defaults to Solana Devnet USDC)
EXPECTED_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU

# Set to "true" ONLY on Judge Sandbox deployments to let browser-created MockUSDC vaults pass mint verification
ALLOW_SANDBOX_MOCK_MINT=true

# Optional server-only Devnet faucet secret key (JSON 64-byte array "[1,2,...]" OR base58 string).
# NEVER prefix with NEXT_PUBLIC_. Leave empty to return HTTP 503 with faucet.solana.com fallback.
FAUCET_SECRET_KEY=
